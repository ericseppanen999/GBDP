{
  "name": "gbdp-backfill",
  "timeout_seconds": 0,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "gbdp_backfill",
      "description": "GBDP backfill pipeline (manual)",
      "existing_cluster_id": "${DB_CLUSTER_ID}",
      "environment_variables": {
        "GBDP_UC_CATALOG": "gbdp",
        "GBDP_UC_BRONZE_SCHEMA": "bronze_gbdp",
        "GBDP_UC_SILVER_SCHEMA": "silver_gbdp",
        "GBDP_UC_GOLD_SCHEMA": "gold_gbdp"
      },
      "spark_python_task": {
        "python_file": "dbfs:/Workspace/Repos/eric.t.seppanen@gmail.com/GBDP/dbx_entry.py",
        "parameters": [
          "backfill",
          "--start",
          "{{start_date}}",
          "--end",
          "{{end_date}}",
          "--sources",
          "configs/sources.yaml",
          "--force",
          "--storage-format",
          "delta",
          "--bronze-root",
          "dbfs:/Volumes/gbdp/bronze_gbdp/bronze_vol/gbdp/bronze",
          "--silver-root",
          "dbfs:/Volumes/gbdp/silver_gbdp/silver_vol/gbdp/silver",
          "--gold-root",
          "dbfs:/Volumes/gbdp/gold_gbdp/gold_vol/gbdp/gold",
          "--manual-root",
          "dbfs:/Volumes/gbdp/bronze_gbdp/bronze_vol/gbdp/manual",
          "--retries",
          "2",
          "--retry-delay",
          "5",
          "--chunk",
          "month",
          "--uc-catalog",
          "gbdp",
          "--uc-bronze-schema",
          "bronze_gbdp",
          "--uc-silver-schema",
          "silver_gbdp",
          "--uc-gold-schema",
          "gold_gbdp",
          "--uc-mode",
          "managed"
        ]
      }
    }
  ],
  "parameters": [
    {
      "name": "start_date",
      "default": "1960-04-12"
    },
    {
      "name": "end_date",
      "default": "1960-04-19"
    }
  ]
}
