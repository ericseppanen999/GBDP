{
  "name": "gbdp-nightly",
  "timeout_seconds": 0,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "gbdp_run",
      "description": "GBDP nightly pipeline",
      "existing_cluster_id": "${DB_CLUSTER_ID}",
      "spark_python_task": {
        "python_file": "dbfs:/Workspace/Repos/eric.t.seppanen@gmail.com/GBDP/dbx_entry.py",
        "parameters": [
          "run",
          "--start",
          "{{date}}",
          "--end",
          "{{date}}",
          "--sources",
          "configs/sources.yaml",
          "--retries",
          "2",
          "--retry-delay",
          "5"
        ]
      }
    },
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 4 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  }
}
