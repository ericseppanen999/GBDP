# Copy to .env (never commit .env). Values here are placeholders.

# --- FastAPI serving layer (python -m gbdp.cli serve) ---
# duckdb (default): local gold under GBDP_DATA_ROOT / GBDP_GOLD_ROOT, via DuckDB.
# databricks: the same endpoints, read from Unity Catalog gold tables through a SQL warehouse.
GBDP_SERVE_BACKEND=duckdb

# Bearer token required on POST /query and POST /metrics/query when set.
# GBDP_API_TOKEN=

# --- Cloud mode (GBDP_SERVE_BACKEND=databricks) ---
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=            # a token that can SELECT on the gold schema (SELECT-only is best)
# GBDP_WAREHOUSE_ID=a9d3d2589a30ab67
# GBDP_SERVE_CATALOG=gbdp
# GBDP_SERVE_SCHEMA=gold_gbdp
# GBDP_SERVE_UC_MODE=managed   # managed (renames 2b -> c_2b) or external
# GBDP_SERVE_TIMEOUT_S=120     # give up on (and cancel) a statement after this long
